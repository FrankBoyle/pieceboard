{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/FrankBoyle/pieceboard/main/schemas/layout-check-v1.schema.json",
  "title": "UI Sheet compact image-free layout check",
  "type": "object",
  "required": [
    "format",
    "scanStatus",
    "sourceWarnings",
    "coverage",
    "counts",
    "pages",
    "results"
  ],
  "properties": {
    "format": {
      "const": "ui-sheet/layout-check-v1"
    },
    "scanStatus": {
      "enum": [
        "completed",
        "unverified"
      ]
    },
    "sourceWarnings": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "coverage": {
      "enum": [
        "observed",
        "partial",
        "insufficient"
      ]
    },
    "counts": {
      "type": "object",
      "required": [
        "rules",
        "passed",
        "findings",
        "incomplete"
      ],
      "properties": {
        "rules": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        },
        "passed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        },
        "findings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        },
        "incomplete": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        }
      },
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "page",
          "scope",
          "coverage",
          "counts"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "scope": {
            "$ref": "layout-v1.schema.json#/$defs/scope"
          },
          "coverage": {
            "enum": [
              "observed",
              "partial",
              "insufficient"
            ]
          },
          "counts": {
            "$ref": "layout-v1.schema.json#/$defs/counts"
          }
        },
        "additionalProperties": false
      }
    },
    "results": {
      "type": "array",
      "maxItems": 600,
      "items": {
        "$ref": "layout-v1.schema.json#/$defs/compactResult"
      }
    }
  },
  "additionalProperties": false
}
