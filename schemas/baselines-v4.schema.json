{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/FrankBoyle/pieceboard/main/schemas/baselines-v4.schema.json",
  "title": "UI Sheet approved button baselines",
  "type": "object",
  "required": [
    "format",
    "rules"
  ],
  "properties": {
    "format": {
      "const": "ui-sheet/baselines-v4"
    },
    "rules": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "scope",
          "group",
          "style",
          "reason"
        ],
        "properties": {
          "id": {
            "$ref": "common-v1.schema.json#/$defs/id"
          },
          "scope": {
            "$ref": "common-v1.schema.json#/$defs/baselineScope"
          },
          "group": {
            "$ref": "common-v1.schema.json#/$defs/group"
          },
          "style": {
            "$ref": "common-v1.schema.json#/$defs/style"
          },
          "reason": {
            "$ref": "common-v1.schema.json#/$defs/review/properties/reason"
          },
          "source": {
            "$ref": "common-v1.schema.json#/$defs/source"
          },
          "recordedAt": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
