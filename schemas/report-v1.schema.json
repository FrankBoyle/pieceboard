{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/FrankBoyle/pieceboard/main/schemas/report-v1.schema.json",
  "title": "UI Sheet current report",
  "description": "Current producer contract for ui-sheet/v1. Older reports can be viewable but fail this schema; regenerate before using current comparisons.",
  "type": "object",
  "required": [
    "format",
    "name",
    "generatedAt",
    "scannedFiles",
    "scanScope",
    "sourceExclusions",
    "warnings",
    "items"
  ],
  "properties": {
    "format": {
      "const": "ui-sheet/v1"
    },
    "name": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string"
    },
    "scannedFiles": {
      "type": "integer",
      "minimum": 0
    },
    "scanScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceExclusions": {
      "type": "integer",
      "minimum": 0
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "message"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "subtype",
          "source",
          "definitions",
          "usages"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "components",
              "colors",
              "typography",
              "assets",
              "tokens"
            ]
          },
          "subtype": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "definitions": {
            "type": "array",
            "items": {
              "$ref": "common-v1.schema.json#/$defs/location"
            }
          },
          "usages": {
            "type": "array",
            "items": {
              "$ref": "common-v1.schema.json#/$defs/location"
            }
          },
          "styleReferences": {
            "type": "array",
            "items": {
              "$ref": "common-v1.schema.json#/$defs/location"
            }
          },
          "pageMatches": {
            "type": "array",
            "items": {
              "$ref": "common-v1.schema.json#/$defs/location"
            }
          },
          "classNames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "value": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "docs": {
            "type": [
              "string",
              "null"
            ]
          },
          "preview": {
            "anyOf": [
              {
                "$ref": "common-v1.schema.json#/$defs/image"
              },
              {
                "type": "null"
              }
            ]
          },
          "captures": {
            "type": "array",
            "items": {
              "$ref": "common-v1.schema.json#/$defs/capture"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "scanRunId": {
      "type": "string",
      "pattern": "^[a-f0-9-]{36}$"
    },
    "sourceRevision": {
      "anyOf": [
        {
          "$ref": "common-v1.schema.json#/$defs/sourceRevision"
        },
        {
          "type": "null"
        }
      ]
    },
    "consistency": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "format",
            "findingIdentity",
            "scope",
            "counts",
            "observations",
            "findings",
            "baselinesUsed"
          ],
          "properties": {
            "format": {
              "const": "ui-sheet/consistency-v1"
            },
            "findingIdentity": {
              "const": "ui-sheet/button-finding-v6"
            },
            "scope": {
              "$ref": "common-v1.schema.json#/$defs/scope"
            },
            "counts": {
              "$ref": "common-v1.schema.json#/$defs/buttonCounts"
            },
            "observations": {
              "type": "array",
              "items": {
                "$ref": "common-v1.schema.json#/$defs/observation"
              }
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "kind",
                  "status",
                  "evidence",
                  "reference",
                  "group",
                  "total",
                  "common",
                  "outlier",
                  "differences"
                ],
                "properties": {
                  "id": {
                    "$ref": "common-v1.schema.json#/$defs/id"
                  },
                  "kind": {
                    "const": "button-style-outlier"
                  },
                  "status": {
                    "const": "possible difference"
                  },
                  "evidence": {
                    "type": "string"
                  },
                  "reference": {
                    "enum": [
                      "approved",
                      "inferred"
                    ]
                  },
                  "group": {
                    "$ref": "common-v1.schema.json#/$defs/group"
                  },
                  "total": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "common": {
                    "type": "object",
                    "required": [
                      "count",
                      "example"
                    ],
                    "properties": {
                      "count": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "example": {
                        "anyOf": [
                          {
                            "$ref": "common-v1.schema.json#/$defs/observationId"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "additionalProperties": true
                  },
                  "outlier": {
                    "type": "object",
                    "required": [
                      "count",
                      "example"
                    ],
                    "properties": {
                      "count": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "example": {
                        "$ref": "common-v1.schema.json#/$defs/observationId"
                      }
                    },
                    "additionalProperties": true
                  },
                  "differences": {
                    "type": "array",
                    "items": {
                      "$ref": "common-v1.schema.json#/$defs/difference"
                    }
                  },
                  "decisionAnchor": {
                    "$ref": "common-v1.schema.json#/$defs/anchor"
                  },
                  "review": {
                    "$ref": "common-v1.schema.json#/$defs/review"
                  }
                },
                "additionalProperties": true
              }
            },
            "baselinesUsed": {
              "type": "array",
              "items": {
                "$ref": "common-v1.schema.json#/$defs/id"
              }
            },
            "instrumentation": {
              "$ref": "common-v1.schema.json#/$defs/instrumentation"
            },
            "appearances": {
              "type": "array",
              "items": {
                "$ref": "common-v1.schema.json#/$defs/appearance"
              }
            },
            "previews": {
              "type": "object",
              "additionalProperties": {
                "$ref": "common-v1.schema.json#/$defs/preview"
              }
            },
            "previewCoverage": {
              "$ref": "common-v1.schema.json#/$defs/previewCoverage"
            },
            "previewLimit": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "format",
            "pages"
          ],
          "properties": {
            "format": {
              "const": "ui-sheet/consistency-v2"
            },
            "pages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "format",
                  "findingIdentity",
                  "scope",
                  "counts",
                  "observations",
                  "findings",
                  "baselinesUsed"
                ],
                "properties": {
                  "format": {
                    "const": "ui-sheet/consistency-v1"
                  },
                  "findingIdentity": {
                    "const": "ui-sheet/button-finding-v6"
                  },
                  "scope": {
                    "$ref": "common-v1.schema.json#/$defs/scope"
                  },
                  "counts": {
                    "$ref": "common-v1.schema.json#/$defs/buttonCounts"
                  },
                  "observations": {
                    "type": "array",
                    "items": {
                      "$ref": "common-v1.schema.json#/$defs/observation"
                    }
                  },
                  "findings": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "id",
                        "kind",
                        "status",
                        "evidence",
                        "reference",
                        "group",
                        "total",
                        "common",
                        "outlier",
                        "differences"
                      ],
                      "properties": {
                        "id": {
                          "$ref": "common-v1.schema.json#/$defs/id"
                        },
                        "kind": {
                          "const": "button-style-outlier"
                        },
                        "status": {
                          "const": "possible difference"
                        },
                        "evidence": {
                          "type": "string"
                        },
                        "reference": {
                          "enum": [
                            "approved",
                            "inferred"
                          ]
                        },
                        "group": {
                          "$ref": "common-v1.schema.json#/$defs/group"
                        },
                        "total": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "common": {
                          "type": "object",
                          "required": [
                            "count",
                            "example"
                          ],
                          "properties": {
                            "count": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "example": {
                              "anyOf": [
                                {
                                  "$ref": "common-v1.schema.json#/$defs/observationId"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          },
                          "additionalProperties": true
                        },
                        "outlier": {
                          "type": "object",
                          "required": [
                            "count",
                            "example"
                          ],
                          "properties": {
                            "count": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "example": {
                              "$ref": "common-v1.schema.json#/$defs/observationId"
                            }
                          },
                          "additionalProperties": true
                        },
                        "differences": {
                          "type": "array",
                          "items": {
                            "$ref": "common-v1.schema.json#/$defs/difference"
                          }
                        },
                        "decisionAnchor": {
                          "$ref": "common-v1.schema.json#/$defs/anchor"
                        },
                        "review": {
                          "$ref": "common-v1.schema.json#/$defs/review"
                        }
                      },
                      "additionalProperties": true
                    }
                  },
                  "baselinesUsed": {
                    "type": "array",
                    "items": {
                      "$ref": "common-v1.schema.json#/$defs/id"
                    }
                  },
                  "instrumentation": {
                    "$ref": "common-v1.schema.json#/$defs/instrumentation"
                  },
                  "appearances": {
                    "type": "array",
                    "items": {
                      "$ref": "common-v1.schema.json#/$defs/appearance"
                    }
                  },
                  "previews": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "common-v1.schema.json#/$defs/preview"
                    }
                  },
                  "previewCoverage": {
                    "$ref": "common-v1.schema.json#/$defs/previewCoverage"
                  },
                  "previewLimit": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "crossPageConsistency": {
      "type": "object",
      "required": [
        "format",
        "findingIdentity",
        "coverage",
        "counts",
        "findings",
        "baselinesUsed"
      ],
      "properties": {
        "format": {
          "const": "ui-sheet/cross-page-v1"
        },
        "findingIdentity": {
          "const": "ui-sheet/cross-page-finding-v5"
        },
        "coverage": {
          "$ref": "common-v1.schema.json#/$defs/coverage"
        },
        "counts": {
          "type": "object",
          "required": [
            "multiPageGroups",
            "comparableGroups",
            "undersampledGroups",
            "tiedGroups",
            "skippedObservations",
            "visibilityIncompletePages",
            "styleIncompletePages"
          ],
          "properties": {
            "multiPageGroups": {
              "type": "integer",
              "minimum": 0
            },
            "comparableGroups": {
              "type": "integer",
              "minimum": 0
            },
            "undersampledGroups": {
              "type": "integer",
              "minimum": 0
            },
            "tiedGroups": {
              "type": "integer",
              "minimum": 0
            },
            "skippedObservations": {
              "type": "integer",
              "minimum": 0
            },
            "visibilityIncompletePages": {
              "type": "integer",
              "minimum": 0
            },
            "styleIncompletePages": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": true
        },
        "baselinesUsed": {
          "type": "array",
          "items": {
            "$ref": "common-v1.schema.json#/$defs/id"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "evidence",
              "reference",
              "group",
              "context",
              "common",
              "outlier",
              "differences"
            ],
            "properties": {
              "id": {
                "$ref": "common-v1.schema.json#/$defs/id"
              },
              "kind": {
                "const": "cross-page-button-style-outlier"
              },
              "evidence": {
                "type": "string"
              },
              "reference": {
                "enum": [
                  "approved",
                  "inferred"
                ]
              },
              "group": {
                "$ref": "common-v1.schema.json#/$defs/group"
              },
              "context": {
                "type": "object",
                "required": [
                  "viewport",
                  "theme",
                  "pixelRatio",
                  "browser"
                ],
                "properties": {
                  "viewport": {
                    "$ref": "common-v1.schema.json#/$defs/viewport"
                  },
                  "theme": {
                    "type": "string"
                  },
                  "pixelRatio": {
                    "$ref": "common-v1.schema.json#/$defs/pixelRatio"
                  },
                  "browser": {
                    "$ref": "common-v1.schema.json#/$defs/browser"
                  }
                },
                "additionalProperties": true
              },
              "common": {
                "type": "object",
                "required": [
                  "pageCount",
                  "count",
                  "example"
                ],
                "properties": {
                  "pageCount": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "example": {
                    "anyOf": [
                      {
                        "type": "object",
                        "required": [
                          "page",
                          "url",
                          "observation",
                          "source"
                        ],
                        "properties": {
                          "page": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "url": {
                            "type": "string"
                          },
                          "observation": {
                            "$ref": "common-v1.schema.json#/$defs/observationId"
                          },
                          "source": {
                            "$ref": "common-v1.schema.json#/$defs/source"
                          }
                        },
                        "additionalProperties": true
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "additionalProperties": true
              },
              "outlier": {
                "type": "object",
                "required": [
                  "pageCount",
                  "count",
                  "example"
                ],
                "properties": {
                  "pageCount": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "example": {
                    "anyOf": [
                      {
                        "type": "object",
                        "required": [
                          "page",
                          "url",
                          "observation",
                          "source"
                        ],
                        "properties": {
                          "page": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "url": {
                            "type": "string"
                          },
                          "observation": {
                            "$ref": "common-v1.schema.json#/$defs/observationId"
                          },
                          "source": {
                            "$ref": "common-v1.schema.json#/$defs/source"
                          }
                        },
                        "additionalProperties": true
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "additionalProperties": true
              },
              "differences": {
                "type": "array",
                "items": {
                  "$ref": "common-v1.schema.json#/$defs/difference"
                }
              },
              "decisionAnchor": {
                "$ref": "common-v1.schema.json#/$defs/anchor"
              },
              "review": {
                "$ref": "common-v1.schema.json#/$defs/review"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "decisionSummary": {
      "$ref": "common-v1.schema.json#/$defs/decisionSummary"
    },
    "baselineSummary": {
      "$ref": "common-v1.schema.json#/$defs/baselineSummary"
    },
    "captureSummary": {
      "type": "object",
      "required": [
        "captured"
      ],
      "properties": {
        "captured": {
          "type": "integer",
          "minimum": 0
        },
        "matched": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 0
        },
        "url": {
          "type": "string"
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "url",
              "captured"
            ],
            "properties": {
              "url": {
                "type": "string"
              },
              "captured": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "observedPages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url",
          "matchingSourceLocations",
          "method"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "matchingSourceLocations": {
            "type": "integer",
            "minimum": 0
          },
          "method": {
            "const": "unique-id-and-tag"
          }
        },
        "additionalProperties": true
      }
    },
    "elementConsistency": {
      "$ref": "element-pages-v1.schema.json"
    },
    "elementBaselineSummary": {
      "$ref": "common-v1.schema.json#/$defs/baselineSummary"
    },
    "scanProgress": {
      "$ref": "common-v1.schema.json#/$defs/pageProgress"
    },
    "tokenSource": {
      "$ref": "token-source-v1.schema.json"
    },
    "layoutAudit": {
      "$ref": "layout-pages-v1.schema.json"
    },
    "responsiveAudit": {
      "$ref": "responsive-audit-v1.schema.json"
    }
  },
  "additionalProperties": true
}
