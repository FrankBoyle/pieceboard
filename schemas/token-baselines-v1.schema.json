{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/FrankBoyle/pieceboard/main/schemas/token-baselines-v1.schema.json",
  "title": "UI Sheet approved scoped token declarations",
  "type": "object",
  "required": [
    "format",
    "rules"
  ],
  "properties": {
    "format": {
      "const": "ui-sheet/token-baselines-v1"
    },
    "rules": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "token",
          "file",
          "context",
          "value",
          "important",
          "reason",
          "recordedAt"
        ],
        "properties": {
          "id": {
            "$ref": "token-source-v1.schema.json#/$defs/id"
          },
          "token": {
            "$ref": "token-source-v1.schema.json#/$defs/tokenName"
          },
          "file": {
            "$ref": "token-source-v1.schema.json#/$defs/file"
          },
          "context": {
            "$ref": "token-source-v1.schema.json#/$defs/context"
          },
          "value": {
            "type": "string",
            "maxLength": 131072
          },
          "important": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "\\S"
          },
          "recordedAt": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "description": "Exact source-value approvals scoped by file, token, and full rule/at-rule context. Runtime validation additionally checks IDs, unique scopes, dates, and file-size bounds."
}
