{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/FrankBoyle/pieceboard/main/schemas/tokens-v1.schema.json",
  "title": "UI Sheet compact scoped token declarations",
  "type": "object",
  "required": [
    "format",
    "scanStatus",
    "sourceStatus",
    "total",
    "truncated",
    "entries"
  ],
  "properties": {
    "format": {
      "const": "ui-sheet/tokens-v1"
    },
    "scanStatus": {
      "enum": [
        "completed",
        "unverified"
      ]
    },
    "sourceStatus": {
      "enum": [
        "available",
        "missing"
      ]
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "truncated": {
      "type": "boolean"
    },
    "entries": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "id",
          "token",
          "file",
          "context",
          "value",
          "important",
          "line",
          "column",
          "ambiguous"
        ],
        "properties": {
          "id": {
            "$ref": "token-source-v1.schema.json#/$defs/id"
          },
          "token": {
            "$ref": "token-source-v1.schema.json#/$defs/tokenName"
          },
          "file": {
            "$ref": "token-source-v1.schema.json#/$defs/file"
          },
          "context": {
            "$ref": "token-source-v1.schema.json#/$defs/context"
          },
          "value": {
            "type": "string",
            "maxLength": 131072
          },
          "important": {
            "type": "boolean"
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "column": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "ambiguous": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
