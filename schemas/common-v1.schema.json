          "minLength": 1,
          "maxLength": 120,
          "not": {
            "const": "unknown"
          }
        },
        "pixelRatio": {
          "$ref": "#/$defs/pixelRatio"
        }
      },
      "additionalProperties": true
    },
    "elementApprovalTemplate": {
      "type": "object",
      "required": [
        "id",
