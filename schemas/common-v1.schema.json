      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "viewport": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            }
          },
          "additionalProperties": true
        },
        "theme": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "pixelRatio": {
          "$ref": "#/$defs/pixelRatio"
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "browser": {
          "$ref": "#/$defs/browser"
        },
        "instrumentedSources": {
          "type": "boolean"
        },
        "maskSelectorsConfigured": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "pageProgress": {
      "type": "object",
      "required": [
        "requested",
        "observed",
        "captured",
        "active",
        "failed"
      ],
      "properties": {
        "requested": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "observed": {
          "type": "array",
          "maxItems": 500,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          }
        },
        "captured": {
          "type": "array",
          "maxItems": 500,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          }
        },
        "skipped": {
          "type": "array",
          "maxItems": 500,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          }
        },
        "active": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "index",
                "phase"
              ],
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 500
                },
                "phase": {
                  "enum": [
                    "observe",
                    "capture"
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "failed": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "index",
                "phase"
              ],
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 500
                },
                "phase": {
                  "enum": [
                    "observe",
                    "capture"
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "description": "Bounded page indexes only, never URLs or data. Runtime additionally checks sorted indexes, indexes<=requested, and completed-phase relationships.",
      "not": {
        "required": [
          "active",
          "failed"
        ],
        "properties": {
          "active": {
            "type": "object"
          },
          "failed": {
            "type": "object"
          }
        }
      }
    }
  }
