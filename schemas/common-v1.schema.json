        "properties": {
          "selector": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "family": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_. -]{0,79}$"
          },
          "variant": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_. -]{0,79}$"
          }
        },
        "additionalProperties": true
      }
    },
    "elementGroups": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "selector",
          "family",
          "type"
        ],
        "properties": {
          "selector": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "family": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_. -]{0,79}$"
          },
          "variant": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_. -]{0,79}$"
          },
          "type": {
            "enum": [
