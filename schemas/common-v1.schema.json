            "capturedAt": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$" },
            "screenshotSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
            "servedSha": { "type": ["string", "null"], "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "observation": {
      "type": "object",
