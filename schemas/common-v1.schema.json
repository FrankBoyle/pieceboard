            "unspecified"
          ]
        },
        "type": {
          "enum": [
            "inputs",
            "dropdowns",
            "selectors",
            "tabs",
            "headers",
            "sidebars",
            "navigation",
            "headings",
            "text"
          ]
        },
        "tag": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,79}$"
        },
        "nativeType": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_. -]{0,79}$"
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      },
      "additionalProperties": true
